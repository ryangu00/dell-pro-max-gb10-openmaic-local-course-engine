# Dummy key: activates this provider slot; an unauthenticated local endpoint ignores it.
# Replace <port> and both <served-model> placeholders before use.
DEEPSEEK_API_KEY=local-placeholder
DEEPSEEK_BASE_URL=http://127.0.0.1:<port>/v1
DEEPSEEK_MODELS=<served-model>
DEFAULT_MODEL=deepseek:<served-model>
